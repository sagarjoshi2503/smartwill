# Same Google OAuth Client ID as web/.env.example's VITE_GOOGLE_CLIENT_ID —
# used server-side to verify the ID token's signature. Not a secret, but must
# match the frontend's value. Deliberately a distinct key name (no VITE_
# prefix) so this service's config doesn't share a key with web/'s.
GOOGLE_CLIENT_ID=

# MongoDB connection string. Server-side only, never exposed to the frontend.
MONGODB_URI=

# Signs and verifies the JWTs issued on admin/testator login (see
# _app/core/jwt_auth.py). Must be a long random secret, server-side only,
# never exposed to the frontend. Generate with e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=

# Session timeout in minutes — applies to both admin and testator sessions.
# Optional, defaults to 15 (see _app/core/config.py).
JWT_EXPIRE_MINUTES=

# How many days a testator's Wills stay listed in "My Wills". Optional,
# defaults to 30 (see _app/core/config.py).
WILL_VISIBLE_DAYS=

# Database name within the MongoDB cluster above. Defaults to "smartwill" if
# unset, so production (Vercel) doesn't need to set this. Local dev should
# point at a separate database (e.g. "smartwill-dev") to avoid touching prod data.
DB_NAME=

# Recipient notified by email whenever a testator submits their Will for review.
ADMIN_REVIEW_EMAIL=

# Office contact details shown on the site (footer "Office & Contact" card)
# via GET /api/contact-us/info. Each defaults to the real current value in
# _app/core/config.py, so these only need setting if the office's address/
# phone/email ever changes and you want it updated without a frontend
# redeploy.
OFFICE_ADDRESS=
OFFICE_PHONE=
OFFICE_EMAIL=

# Comma-separated list of origins allowed to call this API (see
# _app/core/middleware.py). Required — no default.
# e.g. http://localhost:5174,https://www.forwardlegacy.co.in,https://www.dev.forwardlegacy.co.in
CORS_ALLOW_ORIGINS=

# Email is sent via either Resend or SendGrid, chosen by the Vercel flags
# "use-resend-for-email" / "use-sendgrid-for-email" (see _app/shared/email.py).
# Only the provider selected by whichever flag is enabled needs to be
# configured; if the selected provider's keys are empty, the notification is
# skipped (and logged) rather than failing the Will action that triggered it.

# Resend (https://resend.com) transactional email API.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# SendGrid (https://sendgrid.com) transactional email API.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Vercel Flags SDK — used by flags/flags.ts (a sibling Vercel service) to
# evaluate the "enable-admin-button" flag. Documented here only because
# Vercel shares one flat env-var pool across every Service in the project.
FLAGS_SECRET=
FLAGS=

# Twilio (https://twilio.com) — used to deliver OTP codes by SMS during phone
# sign-in. account_sid and auth_token are secrets; from_number is the
# project's provisioned Twilio number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Razorpay (https://razorpay.com) Standard Checkout — used to create orders
# and verify payment signatures for Will submission payments (see
# _app/features/payments). key_id is not secret (the frontend also needs it,
# as VITE_RAZORPAY_KEY_ID — see web/.env.example); key_secret must stay
# server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Outbound-call/index-creation timeouts (seconds/ms) and security cooldowns
# (seconds) — all optional, each defaults to the value every environment has
# used until now (see _app/core/config.py). Only set one of these if this
# specific environment genuinely needs a different value — e.g. a shorter
# OTP_RESEND_COOLDOWN_SECONDS / ADMIN_LOGIN_*_SECONDS in a CI/staging
# environment that exercises those flows repeatedly and would otherwise
# lock itself out.
RAZORPAY_TIMEOUT_SEC=
INDEX_ENSURE_TIMEOUT_MS=
OTP_RESEND_COOLDOWN_SECONDS=
ADMIN_LOGIN_WINDOW_SECONDS=
ADMIN_LOGIN_LOCKOUT_SECONDS=

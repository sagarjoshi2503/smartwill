function renderModal(){
  if(!state.modal) return "";
  if(state.modal==="testator"){
    return `<div class="modal-overlay">
      <div class="modal-box">
        <h3>Who is the Testator?</h3>
        <p>The testator (or testatrix, if female) is simply the person making the Will — the owner of the assets being bequeathed. To make a valid Will in India, the testator must:</p>
        <ul>
          <li>Be a major — 18 years of age or older</li>
          <li>Be of sound mind and understand what they are signing</li>
          <li>Sign the Will voluntarily, free from pressure or influence</li>
          <li>Have the legal right to dispose of the property being bequeathed</li>
        </ul>
        <p>You, as the testator, may leave your self-acquired property to whomever you choose.</p>
        <button class="btn btn-primary modal-close" data-action="closeModal">Got it</button>
      </div>
    </div>`;
  }
  if(state.modal==="witness"){
    return `<div class="modal-overlay">
      <div class="modal-box">
        <h3>Who can be a Witness?</h3>
        <p>Under the Indian Succession Act, 1925, any person of sound mind who is a major (18 or older) and capable of signing their own name can act as a witness. At least two witnesses are required, and neither needs to know what the Will actually says.</p>
        <ul>
          <li><strong>Signing:</strong> each witness must see the testator sign the Will, or be told directly by the testator that the signature is theirs. Both witnesses then sign the Will in the testator's presence.</li>
          <li><strong>Not a beneficiary:</strong> it's best to avoid choosing someone who is also inheriting under the Will, or their spouse — for some communities, being a witness can void that person's own inheritance.</li>
          <li><strong>An executor can witness:</strong> the person you've asked to manage your estate is allowed to also act as a witness.</li>
          <li><strong>Family members can witness</strong>, but an independent, impartial person is generally the safer choice to avoid any future dispute.</li>
        </ul>
        <p>In short: a witness simply needs to be an adult of sound mind, willing to watch you sign and sign the document themselves — they don't need to be related to you at all.</p>
        <button class="btn btn-primary modal-close" data-action="closeModal">Got it</button>
      </div>
    </div>`;
  }
  return "";
}


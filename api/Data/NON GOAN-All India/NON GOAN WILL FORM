<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Will Generator — Non-Goan Will</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#1c2431;
    --ink-soft:#3d4759;
    --paper:#faf9f6;
    --paper-line:#e4e0d6;
    --panel:#ffffff;
    --seal:#7a2e2e;
    --seal-dark:#5e2323;
    --brass:#9c7f3f;
    --ok:#3c6e47;
    --err:#a3312a;
    --border:#d9d4c6;
    --radius:3px;
  }
  *{box-sizing:border-box;}
  html,body{margin:0;padding:0;}
  body{
    background:var(--ink);
    background-image:
      radial-gradient(1200px 600px at 10% -10%, #2a3245 0%, transparent 60%),
      radial-gradient(1000px 500px at 110% 10%, #232a3a 0%, transparent 55%);
    font-family:'Inter',sans-serif;
    color:var(--ink);
    min-height:100vh;
  }
  #app{max-width:900px;margin:0 auto;padding:28px 20px 80px;}

  .brandbar{display:flex;align-items:center;gap:14px;margin-bottom:22px;color:#f2efe7;}
  .seal-mark{
    width:40px;height:40px;border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #9a3f3f, var(--seal-dark));
    display:flex;align-items:center;justify-content:center;
    font-family:'Source Serif 4',serif;font-weight:700;color:#f2e6c9;font-size:15px;
    box-shadow:0 0 0 3px rgba(242,239,231,0.08), inset 0 0 6px rgba(0,0,0,0.4);
    flex-shrink:0;
  }
  .brandbar h1{font-family:'Source Serif 4',serif;font-weight:700;font-size:22px;margin:0;letter-spacing:0.3px;}
  .brandbar p{margin:2px 0 0;font-size:12.5px;color:#b7bcc9;}

  .stepper{
    display:flex;flex-wrap:wrap;gap:0;background:#f2efe6;border:1px solid var(--paper-line);
    border-radius:var(--radius);overflow:hidden;margin-bottom:22px;
    box-shadow:0 10px 30px rgba(0,0,0,0.25);
  }
  .step-tab{
    flex:1 1 auto;min-width:96px;text-align:center;padding:10px 6px;font-size:11px;font-weight:600;
    color:#8b8571;border-right:1px solid var(--paper-line);cursor:default;position:relative;
    letter-spacing:0.2px;
  }
  .step-tab:last-child{border-right:none;}
  .step-tab .n{display:block;font-family:'Source Serif 4',serif;font-size:13px;margin-bottom:2px;}
  .step-tab.done{color:var(--seal-dark);cursor:pointer;background:#ece5d3;}
  .step-tab.active{color:#fff;background:var(--ink);}
  .step-tab.active .n{color:#e7c98f;}

  .card{
    background:var(--panel);border:1px solid var(--paper-line);border-radius:var(--radius);
    padding:28px 30px;box-shadow:0 20px 45px rgba(0,0,0,0.28);
  }
  .card h2{font-family:'Source Serif 4',serif;font-size:21px;margin:0 0 4px;color:var(--ink);}
  .card .sub{font-size:13px;color:#6b6f7d;margin:0 0 22px;line-height:1.5;}

  .row{display:flex;gap:16px;flex-wrap:wrap;margin-bottom:16px;}
  .field{flex:1 1 220px;display:flex;flex-direction:column;gap:6px;}
  .field.full{flex-basis:100%;}
  label{font-size:12.5px;font-weight:600;color:var(--ink-soft);display:flex;align-items:center;gap:5px;}
  label .req{color:var(--seal);}
  input[type=text],input[type=number],select,textarea{
    font-family:'Inter',sans-serif;font-size:14px;padding:9px 11px;border:1px solid var(--border);
    border-radius:var(--radius);background:#fff;color:var(--ink);outline:none;
  }
  input:focus,select:focus,textarea:focus{border-color:var(--brass);box-shadow:0 0 0 3px rgba(156,127,63,0.15);}
  input.err,select.err{border-color:var(--err);background:#fdf3f2;}
  .errmsg{font-size:11.5px;color:var(--err);margin-top:1px;}
  .hint{font-size:11.5px;color:#8a8d97;margin-top:1px;}

  .radiogroup{display:flex;gap:10px;flex-wrap:wrap;}
  .pillbtn{
    padding:8px 16px;border:1px solid var(--border);border-radius:20px;background:#fff;
    font-size:13px;cursor:pointer;font-weight:500;color:var(--ink-soft);
  }
  .pillbtn.on{background:var(--ink);color:#fff;border-color:var(--ink);}

  .info-btn{
    display:inline-flex;align-items:center;gap:5px;font-size:12px;color:var(--seal-dark);
    background:#f7ece9;border:1px solid #ecd6d1;padding:5px 11px;border-radius:20px;cursor:pointer;
    font-weight:600;
  }
  .info-btn:hover{background:#f2ddd6;}

  .clause-block{
    background:#f7f5ef;border:1px solid var(--paper-line);border-left:4px solid var(--seal);
    padding:18px 20px;border-radius:var(--radius);margin:14px 0 18px;
  }
  .clause-block .tag{font-size:10.5px;font-weight:700;letter-spacing:1px;color:var(--seal-dark);text-transform:uppercase;}
  .clause-block .clause-text{font-family:'Source Serif 4',serif;font-size:15px;line-height:1.6;margin:8px 0;color:var(--ink);}
  .clause-block .why{font-size:12.5px;color:#5c6070;line-height:1.6;margin-top:10px;padding-top:10px;border-top:1px dashed #d7d2c2;}

  .item-card{
    border:1px solid var(--paper-line);border-radius:var(--radius);padding:16px 18px 6px;margin-bottom:14px;
    background:#fcfbf9;position:relative;
  }
  .item-card .item-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;}
  .item-card .item-title{font-size:12.5px;font-weight:700;color:var(--ink-soft);text-transform:uppercase;letter-spacing:0.4px;}
  .removebtn{background:none;border:none;color:#a3312a;font-size:12px;cursor:pointer;font-weight:600;padding:2px 6px;}
  .removebtn:hover{text-decoration:underline;}

  .addbtn{
    display:inline-flex;align-items:center;gap:6px;background:#fff;border:1.5px dashed var(--border);
    color:var(--ink-soft);font-size:13px;font-weight:600;padding:9px 16px;border-radius:var(--radius);
    cursor:pointer;width:100%;justify-content:center;margin-top:2px;
  }
  .addbtn:hover{border-color:var(--brass);color:var(--brass);}

  .category-title{
    font-family:'Source Serif 4',serif;font-size:16px;font-weight:600;margin:26px 0 4px;color:var(--ink);
    display:flex;align-items:baseline;gap:8px;
  }
  .category-title .letter{color:var(--seal);font-size:14px;}
  .category-sub{font-size:12px;color:#7b7f8c;margin:0 0 12px;}

  .nav-row{display:flex;justify-content:space-between;align-items:center;margin-top:26px;padding-top:20px;border-top:1px solid var(--paper-line);}
  .btn{
    font-family:'Inter',sans-serif;font-size:14px;font-weight:600;padding:11px 24px;border-radius:var(--radius);
    border:none;cursor:pointer;
  }
  .btn-primary{background:var(--ink);color:#fff;}
  .btn-primary:hover{background:#2b3549;}
  .btn-ghost{background:none;color:var(--ink-soft);border:1px solid var(--border);}
  .btn-ghost:hover{background:#f2efe6;}
  .btn:disabled{opacity:0.4;cursor:not-allowed;}

  .step-error-banner{
    background:#fdf3f2;border:1px solid #ecc8c3;color:var(--err);font-size:12.5px;
    padding:10px 14px;border-radius:var(--radius);margin-bottom:16px;font-weight:600;
  }

  /* Modal */
  .modal-overlay{
    position:fixed;inset:0;background:rgba(15,18,26,0.6);display:flex;align-items:center;justify-content:center;
    z-index:200;padding:20px;
  }
  .modal-box{
    background:#fff;border-radius:var(--radius);max-width:560px;width:100%;padding:26px 28px;
    max-height:80vh;overflow-y:auto;box-shadow:0 30px 60px rgba(0,0,0,0.4);
  }
  .modal-box h3{font-family:'Source Serif 4',serif;font-size:19px;margin:0 0 12px;color:var(--ink);}
  .modal-box p, .modal-box li{font-size:13.5px;line-height:1.65;color:var(--ink-soft);}
  .modal-box ul{padding-left:18px;margin:10px 0;}
  .modal-close{margin-top:14px;}

  /* Review / instructions */
  .instructions{
    background:#f2efe6;border:1px solid var(--paper-line);border-radius:var(--radius);
    padding:20px 22px;margin-bottom:20px;
  }
  .instructions h3{font-family:'Source Serif 4',serif;font-size:15px;margin:0 0 10px;color:var(--ink);}
  .spec-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px 20px;}
  .spec-grid .k{font-size:12px;color:#7b7f8c;text-transform:uppercase;letter-spacing:0.3px;}
  .spec-grid .v{font-size:13.5px;font-weight:600;color:var(--ink);margin-bottom:8px;}
  .review-summary{font-size:13px;color:var(--ink-soft);line-height:1.7;margin-bottom:6px;}
  .review-section-title{font-weight:700;color:var(--ink);margin-top:14px;}

  .download-row{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px;}

  @media (max-width:640px){
    .card{padding:20px 16px;}
    .spec-grid{grid-template-columns:1fr;}
  }
</style>
</head>
<body>
<div id="app"></div>
<script>
/* ===================== STATE ===================== */
const RELATIONSHIP_OPTIONS = ["Spouse","Son","Daughter","Father","Mother","Brother","Sister","Grandson","Granddaughter","Nephew","Niece","Friend","Other"];
const ID_TYPES = ["Aadhaar Card","PAN Card","Passport","Voter ID","Driving License"];
const WITNESS_RELATIONS = ["Not a relative","Friend","Neighbour","Colleague","Family member","Executor of the Will","Other"];
const MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"];
const NUM_WORDS = ["zero","one","two","three","four","five","six","seven","eight","nine","ten"];
const OCCUPATIONS = ["Retired","In Service","Business","Profession","Homemaker","Other"];
const WITNESS_DESCRIPTORS = ["Son of","Daughter of","Wife of"];

function newAssetItem(){ return { description:"", beneficiaryName:"", relationship:"", relationshipOther:"", idType:"", idNumber:"" }; }
function newResiduaryItem(){ return { name:"", relationship:"", relationshipOther:"", nationality:"", occupation:"", occupationOther:"", idType:"", idNumber:"" }; }
function newWitness(){ return { name:"", descriptor:"Son of", parentOrSpouseName:"", age:"", maritalStatus:"unmarried", nationality:"", occupation:"", occupationOther:"", residentOf:"", aadhar:"", relation:"", relationOther:"" }; }
function newChild(){ return { name:"" }; }

let state = {
  step: 0,
  showErrors: {},
  modal: null,
  testator: {
    name:"", childOf:"son", parentName:"", pan:"", aadhar:"", age:"",
    maritalStatus:"unmarried", nationality:"", occupation:"", occupationOther:"", residentOf:"",
    spouseName:"", spouseAadhar:"", sons:[], daughters:[],
    day:"", month:"", year:"", place:""
  },
  immovable: { house: [], land: [], commercial: [] },
  vehicles: [],
  personal: [],
  digital: [],
  ip: [],
  residuary: [ newResiduaryItem() ],
  witnesses: [ newWitness(), newWitness() ]
};

const STEPS = [
  {key:"testator", label:"Testator Details"},
  {key:"financial", label:"Financial Assets"},
  {key:"immovable", label:"Immovable Property"},
  {key:"vehicles", label:"Motor Vehicles"},
  {key:"personal", label:"Personal & Valuables"},
  {key:"digitalip", label:"Digital & IP"},
  {key:"residuary", label:"Residuary Clause"},
  {key:"witnesses", label:"Witnesses"},
  {key:"review", label:"Review & Generate"}
];

/* ===================== PATH HELPERS ===================== */
function pathParts(path){ return path.replace(/\[(\d+)\]/g,'.$1').split('.').filter(Boolean); }
function getPath(obj, path){ return pathParts(path).reduce((o,k)=> (o==null? undefined : o[k]), obj); }
function setPath(obj, path, value){
  const parts = pathParts(path);
  let o = obj;
  for(let i=0;i<parts.length-1;i++){ o = o[parts[i]]; }
  o[parts[parts.length-1]] = value;
}
function esc(s){
  return String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}

/* ===================== VALIDATION ===================== */
function validateAssetItem(item){
  const missing=[];
  if(!item.description.trim()) missing.push("description");
  if(!item.beneficiaryName.trim()) missing.push("beneficiaryName");
  if(!item.relationship) missing.push("relationship");
  if(item.relationship==="Other" && !item.relationshipOther.trim()) missing.push("relationshipOther");
  if(!item.idType) missing.push("idType");
  if(!item.idNumber.trim()) missing.push("idNumber");
  return missing;
}
function validateResiduaryItem(item){
  const missing=[];
  if(!item.name.trim()) missing.push("name");
  if(!item.relationship) missing.push("relationship");
  if(item.relationship==="Other" && !item.relationshipOther.trim()) missing.push("relationshipOther");
  if(!item.nationality.trim()) missing.push("nationality");
  if(!item.occupation) missing.push("occupation");
  if(item.occupation==="Other" && !item.occupationOther.trim()) missing.push("occupationOther");
  if(!item.idType) missing.push("idType");
  if(!item.idNumber.trim()) missing.push("idNumber");
  return missing;
}
function validateWitness(w){
  const missing=[];
  if(!w.name.trim()) missing.push("name");
  if(!w.parentOrSpouseName.trim()) missing.push("parentOrSpouseName");
  if(!w.age.trim()) missing.push("age");
  if(!w.nationality.trim()) missing.push("nationality");
  if(!w.occupation) missing.push("occupation");
  if(w.occupation==="Other" && !w.occupationOther.trim()) missing.push("occupationOther");
  if(!w.residentOf.trim()) missing.push("residentOf");
  if(!w.aadhar.trim()) missing.push("aadhar");
  if(!w.relation) missing.push("relation");
  if(w.relation==="Other" && !w.relationOther.trim()) missing.push("relationOther");
  return missing;
}

function validateStep(idx){
  const key = STEPS[idx].key;
  let paths = [];
  if(key==="testator"){
    const t = state.testator;
    ["name","parentName","pan","aadhar","age","nationality","residentOf","day","month","year","place"].forEach(f=>{
      if(!String(t[f]).trim()) paths.push("testator."+f);
    });
    if(!t.occupation) paths.push("testator.occupation");
    if(t.occupation==="Other" && !t.occupationOther.trim()) paths.push("testator.occupationOther");
    if(t.maritalStatus==="married"){
      if(!t.spouseName.trim()) paths.push("testator.spouseName");
      if(!t.spouseAadhar.trim()) paths.push("testator.spouseAadhar");
    }
    t.sons.forEach((c,i)=>{ if(!c.name.trim()) paths.push("testator.sons["+i+"].name"); });
    t.daughters.forEach((c,i)=>{ if(!c.name.trim()) paths.push("testator.daughters["+i+"].name"); });
  } else if(key==="financial"){
    // informational only, always valid
  } else if(key==="immovable"){
    ["house","land","commercial"].forEach(cat=>{
      state.immovable[cat].forEach((it,i)=>{
        validateAssetItem(it).forEach(f=> paths.push("immovable."+cat+"["+i+"]."+f));
      });
    });
  } else if(key==="vehicles"){
    state.vehicles.forEach((it,i)=> validateAssetItem(it).forEach(f=> paths.push("vehicles["+i+"]."+f)));
  } else if(key==="personal"){
    state.personal.forEach((it,i)=> validateAssetItem(it).forEach(f=> paths.push("personal["+i+"]."+f)));
  } else if(key==="digitalip"){
    state.digital.forEach((it,i)=> validateAssetItem(it).forEach(f=> paths.push("digital["+i+"]."+f)));
    state.ip.forEach((it,i)=> validateAssetItem(it).forEach(f=> paths.push("ip["+i+"]."+f)));
  } else if(key==="residuary"){
    if(state.residuary.length===0) paths.push("residuary.__empty");
    state.residuary.forEach((it,i)=> validateResiduaryItem(it).forEach(f=> paths.push("residuary["+i+"]."+f)));
  } else if(key==="witnesses"){
    if(state.witnesses.length<2) paths.push("witnesses.__min");
    state.witnesses.forEach((w,i)=> validateWitness(w).forEach(f=> paths.push("witnesses["+i+"]."+f)));
  } else if(key==="review"){
    // recheck everything
  }
  return paths;
}
function stepIsValid(idx){ return validateStep(idx).length===0; }
function furthestAllowed(){
  for(let i=0;i<STEPS.length;i++){ if(!stepIsValid(i)) return i; }
  return STEPS.length-1;
}

/* ===================== ACTIONS ===================== */
function goNext(){
  const missing = validateStep(state.step);
  if(missing.length>0){ state.showErrors[state.step]=true; render(); scrollToFirstError(); return; }
  state.showErrors[state.step]=false;
  if(state.step < STEPS.length-1){ state.step++; window.scrollTo({top:0,behavior:"smooth"}); }
  render();
}
function goPrev(){ if(state.step>0){ state.step--; window.scrollTo({top:0,behavior:"smooth"}); } render(); }
function goToStep(i){
  if(i<=state.step || i<=furthestAllowed()){ state.step=i; window.scrollTo({top:0,behavior:"smooth"}); render(); }
}
function scrollToFirstError(){
  setTimeout(()=>{ const el=document.querySelector(".err"); if(el) el.scrollIntoView({behavior:"smooth",block:"center"}); },30);
}

function handleClick(e){
  const t = e.target.closest("[data-action]");
  if(!t) return;
  const action = t.getAttribute("data-action");
  const cat = t.getAttribute("data-cat");
  const idx = t.getAttribute("data-idx");
  if(action==="next") goNext();
  else if(action==="prev") goPrev();
  else if(action==="goto") goToStep(parseInt(t.getAttribute("data-step"),10));
  else if(action==="addAsset"){ getPath(state,cat).push(newAssetItem()); render(); }
  else if(action==="removeAsset"){ getPath(state,cat).splice(parseInt(idx,10),1); render(); }
  else if(action==="addResiduary"){ state.residuary.push(newResiduaryItem()); render(); }
  else if(action==="removeResiduary"){ if(state.residuary.length>1){ state.residuary.splice(parseInt(idx,10),1); render(); } }
  else if(action==="addWitness"){ state.witnesses.push(newWitness()); render(); }
  else if(action==="removeWitness"){ if(state.witnesses.length>2){ state.witnesses.splice(parseInt(idx,10),1); render(); } }
  else if(action==="addSon"){ state.testator.sons.push(newChild()); render(); }
  else if(action==="removeSon"){ state.testator.sons.splice(parseInt(idx,10),1); render(); }
  else if(action==="addDaughter"){ state.testator.daughters.push(newChild()); render(); }
  else if(action==="removeDaughter"){ state.testator.daughters.splice(parseInt(idx,10),1); render(); }
  else if(action==="openModal"){ state.modal = t.getAttribute("data-modal"); render(); }
  else if(action==="closeModal"){ state.modal = null; render(); }
  else if(action==="setMarital"){ state.testator.maritalStatus = t.getAttribute("data-val"); render(); }
  else if(action==="setWitnessMarital"){ state.witnesses[parseInt(idx,10)].maritalStatus = t.getAttribute("data-val"); render(); }
  else if(action==="setChildOf"){ state.testator.childOf = t.getAttribute("data-val"); render(); }
  else if(action==="generate"){ generateDocument(); }
  else if(action==="downloadHtml"){ downloadHtmlCopy(); }
}
function handleInput(e){
  const el = e.target;
  const bind = el.getAttribute("data-bind");
  if(!bind) return;
  setPath(state, bind, el.value);
}
function handleChange(e){
  const el = e.target;
  const bind = el.getAttribute("data-bind");
  if(!bind) return;
  setPath(state, bind, el.value);
  render();
}

/* ===================== RENDER HELPERS ===================== */
function fieldError(path){
  if(!state.showErrors[state.step]) return false;
  return validateStep(state.step).includes(path);
}
function inputHtml(opts){
  const {bind,label,placeholder,required,type,full,hint}=opts;
  const val = getPath(state,bind) ?? "";
  const errored = fieldError(bind);
  return `<div class="field ${full?'full':''}">
    <label>${label} ${required?'<span class="req">*</span>':''}</label>
    <input type="${type||'text'}" data-bind="${bind}" value="${esc(val)}" placeholder="${esc(placeholder||'')}" class="${errored?'err':''}">
    ${errored?'<div class="errmsg">This field is required</div>':(hint?`<div class="hint">${hint}</div>`:'')}
  </div>`;
}
function selectHtml(opts){
  const {bind,label,options,required,placeholder,full}=opts;
  const val = getPath(state,bind) ?? "";
  const errored = fieldError(bind);
  return `<div class="field ${full?'full':''}">
    <label>${label} ${required?'<span class="req">*</span>':''}</label>
    <select data-bind="${bind}" class="${errored?'err':''}">
      <option value="">${esc(placeholder||'Select...')}</option>
      ${options.map(o=>`<option value="${esc(o)}" ${val===o?'selected':''}>${esc(o)}</option>`).join('')}
    </select>
    ${errored?'<div class="errmsg">This field is required</div>':''}
  </div>`;
}

function assetItemHtml(catPath, idx, item, label, canRemove){
  const base = catPath+"["+idx+"]";
  return `<div class="item-card">
    <div class="item-head">
      <span class="item-title">${label} ${idx+1}</span>
      ${canRemove?`<button class="removebtn" data-action="removeAsset" data-cat="${catPath}" data-idx="${idx}">Remove</button>`:''}
    </div>
    <div class="row">
      ${inputHtml({bind:base+".description",label:"Description of asset",required:true,full:true,placeholder:"e.g. 3BHK flat at ..., Survey no. ..., Registration no. ..."})}
    </div>
    <div class="row">
      ${inputHtml({bind:base+".beneficiaryName",label:"Bequeathed to (full name)",required:true})}
      ${selectHtml({bind:base+".relationship",label:"Relationship to testator",required:true,options:RELATIONSHIP_OPTIONS})}
    </div>
    ${item.relationship==="Other"?`<div class="row">${inputHtml({bind:base+".relationshipOther",label:"Please specify relationship",required:true})}</div>`:''}
    <div class="row">
      ${selectHtml({bind:base+".idType",label:"Beneficiary's ID proof type",required:true,options:ID_TYPES,placeholder:"Choose ID type"})}
      ${inputHtml({bind:base+".idNumber",label:"ID number",required:true})}
    </div>
  </div>`;
}

function assetCategoryHtml(catPath, items, singularLabel, categoryTitle, letter, hint){
  return `
  <div class="category-title"><span class="letter">${letter}.</span> ${categoryTitle}</div>
  ${hint?`<p class="category-sub">${hint}</p>`:''}
  ${items.map((it,i)=>assetItemHtml(catPath,i,it,singularLabel,true)).join('')}
  <button class="addbtn" data-action="addAsset" data-cat="${catPath}">+ Add another ${singularLabel.toLowerCase()}</button>
  `;
}

/* ===================== STEP RENDERERS ===================== */
function renderTestatorStep(){
  const t = state.testator;
  return `
  <h2>Testator Details</h2>
  <p class="sub">The testator is the person making this Will — you. This section identifies you and, if applicable, your immediate family.</p>

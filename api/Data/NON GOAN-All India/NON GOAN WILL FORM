function render(){
  const app = document.getElementById("app");
  const idx = state.step;
  const missing = validateStep(idx);
  const showBanner = state.showErrors[idx] && missing.length>0;

  const stepRenderers = [renderTestatorStep, renderFinancialStep, renderImmovableStep, renderVehiclesStep, renderPersonalStep, renderDigitalIpStep, renderResiduaryStep, renderWitnessesStep, renderReviewStep];

  const stepperHtml = STEPS.map((s,i)=>{
    let cls = "step-tab";
    if(i===idx) cls+=" active"; else if(i<idx || stepIsValid(i)) cls+=" done";
    return `<div class="${cls}" data-action="goto" data-step="${i}"><span class="n">${i+1}</span>${s.label}</div>`;
  }).join('');

  app.innerHTML = `
    <div class="brandbar">
      <div class="seal-mark">W</div>
      <div>
        <h1>Will Drafting Assistant</h1>
        <p>Non-Goan Will · India</p>
      </div>
    </div>
    <div class="stepper">${stepperHtml}</div>
    <div class="card">
      ${showBanner?'<div class="step-error-banner">Please complete the highlighted required fields before continuing.</div>':''}
      ${stepRenderers[idx]()}
      <div class="nav-row">
        <button class="btn btn-ghost" data-action="prev" ${idx===0?'disabled':''}>Back</button>
        ${idx<STEPS.length-1?'<button class="btn btn-primary" data-action="next">Next</button>':''}
      </div>
    </div>
    ${renderModal()}
  `;
}

/* ===================== DOCUMENT GENERATION ===================== */
function ordinal(n){
  n = parseInt(n,10);
  const s=["th","st","nd","rd"], v=n%100;
  return n+(s[(v-20)%10]||s[v]||s[0]);
}
function numWord(n){ return NUM_WORDS[n] || String(n); }
function relOf(it){ return it.relationship==="Other" ? it.relationshipOther : it.relationship; }
function witRel(w){ return w.relation==="Other" ? w.relationOther : w.relation; }

function assetParagraph(label, it){
  return `<p>${esc(label)}: <u>${esc(it.description)}</u><br>
  Bequeathed to: <u>${esc(it.beneficiaryName)}</u>, Relationship: <u>${esc(relOf(it))}</u>, bearing
  ${esc(it.idType)} Number: <u>${esc(it.idNumber)}</u>.</p>`;
}
function signatureLine(){
  return `<p class="sigline">Testator's Signature: __________________ &nbsp;&nbsp; Witness 1: __________________ &nbsp;&nbsp; Witness 2: __________________</p>`;
}

function occupationOf(obj){ return obj.occupation==="Other" ? obj.occupationOther : obj.occupation; }

function buildWillBody(){
  const t = state.testator;
  const dateStr = (t.day && t.month && t.year) ? `${ordinal(t.day)} day of ${t.month}, ${t.year}` : "____________________";
  const marriedBlock = t.maritalStatus==="married" ? `I am married to <u>${esc(t.spouseName)}</u>, bearing Aadhaar No. <u>${esc(t.spouseAadhar)}</u>` +
    (t.sons.length ? ` and I have ${numWord(t.sons.length)} son${t.sons.length>1?'s':''}, namely, <u>${t.sons.map(s=>esc(s.name)).join(', ')}</u>` : '') +
    (t.daughters.length ? ` and ${numWord(t.daughters.length)} daughter${t.daughters.length>1?'s':''}, namely, <u>${t.daughters.map(d=>esc(d.name)).join(', ')}</u>` : '') + `. ` : '';

  let letterCode = 65; // 'A'
  const sections = [];

  // Financial (always A)
  sections.push({
    letter: String.fromCharCode(letterCode++),
    title: "Financial Assets",
    body: `<p>I bequeath all my financial assets including Bank Accounts, Fixed Deposits (FDs), Recurring Deposits (RDs), Public Provident Fund (PPF), Life Insurance, Stocks, Mutual Funds, Cryptocurrency (Crypto), Digital Wallets, National Pension System (NPS), Bonds, Alternative Investment Fund (AIF), Specialized Investment Fund (SIF), and Portfolio Management Services (PMS) entirely to the nominees registered in those financial instruments.</p>`,
    signAfter: true
  });

  const immov = [...state.immovable.house.map(it=>({...it,_label:"House / Flat"})),
                 ...state.immovable.land.map(it=>({...it,_label:"Land / Plot"})),
                 ...state.immovable.commercial.map(it=>({...it,_label:"Commercial Property"}))];
  if(immov.length){
    sections.push({letter:String.fromCharCode(letterCode++), title:"Immovable Property", body: immov.map(it=>assetParagraph(it._label,it)).join(''), signAfter:false});
  }
  if(state.vehicles.length){
    sections.push({letter:String.fromCharCode(letterCode++), title:"Motor Vehicles", body: state.vehicles.map(it=>assetParagraph("Vehicle / Car",it)).join(''), signAfter:false});
  }
  if(state.personal.length){
    sections.push({letter:String.fromCharCode(letterCode++), title:"Personal & Valuables", body: state.personal.map(it=>assetParagraph("Jewellery & Heirlooms",it)).join(''), signAfter:true});
  }
  const digitalMisc = [...state.digital.map(it=>({...it,_label:"Social Media / Digital"})), ...state.ip.map(it=>({...it,_label:"Intellectual Property"}))];
  if(digitalMisc.length){
    sections.push({letter:String.fromCharCode(letterCode++), title:"Digital & Miscellaneous Assets", body: digitalMisc.map(it=>assetParagraph(it._label,it)).join(''), signAfter:true});
  }

  const sectionsHtml = sections.map(s=>`
    <p class="sectitle">${s.letter}. ${esc(s.title)}:</p>
    ${s.body}
    ${s.signAfter ? signatureLine() : ''}
  `).join('');

  const residuaryHtml = state.residuary.map((r,i)=>{
    return `${esc(relOf(r))}, <u>${esc(r.name)}</u>, nationality <u>${esc(r.nationality)}</u>, occupation <u>${esc(occupationOf(r))}</u>, bearing ${esc(r.idType)} Number: <u>${esc(r.idNumber)}</u>`;
  }).join('; and to ');

  const witnessesHtml = state.witnesses.map((w,i)=>`
    <p>${i+1}) Name: <u>${esc(w.name)}</u>, ${esc(w.descriptor)} <u>${esc(w.parentOrSpouseName)}</u>, Age: <u>${esc(w.age)}</u>,
    ${esc(w.maritalStatus)}, Nationality: <u>${esc(w.nationality)}</u>, Occupation: <u>${esc(occupationOf(w))}</u>,
    Resident of: <u>${esc(w.residentOf)}</u>, bearing Aadhaar Number: <u>${esc(w.aadhar)}</u>, Relation to testator: <u>${esc(witRel(w))}</u><br>
    Signature: __________________________</p>
  `).join('');

  return `
  <p class="willtitle">WILL</p>

  <p>I, <u>${esc(t.name)}</u>, having PAN <u>${esc(t.pan)}</u>, Aadhaar No. <u>${esc(t.aadhar)}</u>,
  ${t.childOf==='son'?'son':'daughter'} of <u>${esc(t.parentName)}</u>, aged <u>${esc(t.age)}</u>,
  ${esc(t.maritalStatus)}, nationality <u>${esc(t.nationality)}</u>, occupation <u>${esc(occupationOf(t))}</u>,
  resident of <u>${esc(t.residentOf)}</u>, ${marriedBlock}
  And on this ${dateStr}, and in the presence of two witnesses whose details appear at the end of this document, make my last and final WILL.</p>

  <p>I am making this last WILL and testament of mine voluntarily and without any compulsion or pressure from any source or person, and in sound health and disposing state of mind. I have not been influenced, cajoled, or coerced in any manner to write this WILL. I do hereby revoke all my previous wills, if any, previously made by me.</p>

  <p>I own the following movable and immovable properties, which are all self-acquired or built out of my own earnings and income, and I have absolute power of disposal of the same.</p>

  <p>I bequeath my specific assets to the designated beneficiaries as outlined below:</p>

  ${sectionsHtml}

  <p>I hereby declare, direct, and devise that all the Rest and Residue of my estate, including any property or assets, both movable and immovable, which I may acquire after the execution of this Will, or which has been inadvertently omitted from this document, shall be given entirely to ${residuaryHtml}.</p>

  <p style="margin-top:26px;">Signature of Testator/Testatrix: __________________________</p>

  <p>I have fully understood the contents, significance, and implications contained in this WILL, which has been executed out of my free will and choice. There has been no misrepresentation with regard to this WILL, and no one has any right to object to or challenge this WILL, as this is the culmination of my discretion and is best for me to safeguard my interest and the interest of my family.</p>

  <p>Testator/Testatrix understands and approves the contents of this document before signing, and was not forced to do so by any person.</p>

  <p>Signature of Testator/Testatrix: __________________________</p>
  <p>Name of Testator/Testatrix: ${esc(t.name)}</p>
  <p>Place: ${esc(t.place)}</p>
  <p>Date: ${dateStr}</p>

  <p class="sectitle" style="margin-top:24px;">WITNESSES</p>
  ${witnessesHtml}
  `;
}

function fullDocumentHtml(){
  const body = buildWillBody();
  return `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Will</title>
  <style>
    @page{ size:A4; margin:25mm 20mm; }
    body{ font-family:'Times New Roman', Times, serif; font-size:12pt; line-height:1.15; color:#000; margin:0; padding:0; }
    .willtitle{ text-align:center; font-size:14pt; font-weight:bold; margin-bottom:20pt; }
    .sectitle{ font-weight:bold; margin-top:14pt; margin-bottom:4pt; }
    p{ margin:0 0 10pt 0; text-align:justify; }
    u{ text-decoration:underline; }
    .sigline{ margin:14pt 0; }
  </style></head>
  <body>${body}</body></html>`;
}

function generateDocument(){
  const html = fullDocumentHtml();
  let iframe = document.getElementById("printFrame");
  if(!iframe){
    iframe = document.createElement("iframe");
    iframe.id = "printFrame";
    iframe.style.position = "fixed";
    iframe.style.right = "0";
    iframe.style.bottom = "0";
    iframe.style.width = "0";
    iframe.style.height = "0";
    iframe.style.border = "0";
    document.body.appendChild(iframe);
  }
  const doc = iframe.contentWindow.document;
  doc.open(); doc.write(html); doc.close();
  setTimeout(()=>{
    iframe.contentWindow.focus();
    iframe.contentWindow.print();
  }, 350);
}
function downloadHtmlCopy(){
  const html = fullDocumentHtml();
  const blob = new Blob([html], {type:"text/html"});
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "Will_" + (state.testator.name.trim().replace(/\s+/g,'_') || "Document") + ".html";
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

/* ===================== INIT ===================== */
document.getElementById("app").addEventListener("click", handleClick);
document.getElementById("app").addEventListener("input", handleInput);
document.getElementById("app").addEventListener("change", handleChange);
render();
</script>

# All India (Non-Goan) Will — single shared PDF template.
#
# Rendered in two passes (see pdf_generator.py):
#   1. Jinja2 renders this file as TEXT (so if/for control blocks can
#      span whole YAML list items), producing plain YAML.
#   2. The result is yaml.safe_load()ed into a flat list of content
#      blocks. pdf_generator.py walks that list once, mapping each
#      block's `type` to a ReportLab flowable:
#        title      - large centered bold heading (used once, for "WILL")
#        heading    - smaller centered bold heading (secondary sections)
#        subheading - left-aligned label line (e.g. "A. Financial Assets:")
#        paragraph  - justified body text
#        pagebreak  - forces a new page
#
# All dynamic, sentence-level text (the opening clause, asset lines, the
# residue clause, executor/guardian appointment clauses, witness
# particulars) is pre-composed in pdf_context.py and handed to this file
# as ready strings/lists — this file only decides section order, static
# boilerplate wording, and which optional sections appear. Edit THIS FILE
# to change wording, add/remove a clause, or reorder sections — no Python
# changes needed for that. The signature-footer line repeated at the
# bottom of every page is drawn by pdf_generator.py's page template, not
# this file, since it's positional/structural, not content.
#
# Only `heading`-type blocks (Appointment of Executor, Executor's Consent,
# Appointment of Guardian, Guardian's Consent, WITNESSES) are printed in
# caps, literally — ReportLab renders plain text with no CSS, so the casing
# has to be real here. `subheading`-type blocks (the lettered A/B/C/... asset
# sections) stay Title Case — deliberately not capitalized, unlike headings.
#
# Every value is piped through the `yamlstr` filter (JSON-encodes it) —
# that's what keeps this valid YAML regardless of quotes/newlines/unicode
# in the underlying data. Don't hand-quote values instead of using it.

- type: title
  text: {{ title_will | yamlstr }}
- type: paragraph
  text: {{ opening_clause | yamlstr }}
- type: paragraph
  text: {{ "I am making this last WILL and testament of mine voluntarily and without any compulsion or pressure from any source or person and in sound health and disposing state of mind. I have not been influenced, cajoled or coerced in any manner to write this WILL. I do hereby revoke all my wills, if any, previously made by me." | yamlstr }}
- type: paragraph
  text: {{ "I own the following movable and immovable properties which are all self-acquired or built out of my own earning and income and have absolute power of disposal of the same." | yamlstr }}
- type: paragraph
  text: {{ "I bequeath my specific assets to the designated beneficiaries as outlined below:" | yamlstr }}
- type: subheading
  text: {{ ("A. " ~ section_title_financial_assets ~ ":") | yamlstr }}
- type: paragraph
  text: {{ "I bequeath all my financial assets including Bank Accounts, Bank Locker, Fixed Deposits (FDs), Recurring Deposits (RDs), Public Provident Fund (PPF), Life Insurance, Stocks, Mutual Funds, Cryptocurrency (Crypto), Digital Wallets, National Pension System (NPS), Bonds, Alternative Investment Fund (AIF), Specialized Investment Fund (SIF), and Portfolio Management Services (PMS) entirely to the nominees registered in those financial instruments." | yamlstr }}
{% if has_immovable or has_vehicle or has_personal or has_social_digital or has_intellectual_property %}
- type: pagebreak
{% if has_immovable %}
- type: subheading
  text: {{ (letter_immovable ~ ". " ~ section_title_immovable ~ ":") | yamlstr }}
{% for line in house_flat_lines %}
- type: paragraph
  text: {{ line | yamlstr }}
{% endfor %}
{% for line in land_plot_lines %}
- type: paragraph
  text: {{ line | yamlstr }}
{% endfor %}
{% for line in commercial_property_lines %}
- type: paragraph
  text: {{ line | yamlstr }}
{% endfor %}
{% endif %}
{% if has_vehicle %}
- type: subheading
  text: {{ (letter_vehicle ~ ". " ~ section_title_vehicle ~ ":") | yamlstr }}
{% for line in vehicle_lines %}
- type: paragraph
  text: {{ line | yamlstr }}
{% endfor %}
{% endif %}
{% if has_personal %}
- type: subheading
  text: {{ (letter_personal ~ ". " ~ section_title_personal ~ ":") | yamlstr }}
{% for line in jewellery_lines %}
- type: paragraph
  text: {{ line | yamlstr }}
{% endfor %}
{% endif %}
{% if has_social_digital %}
- type: subheading
  text: {{ (letter_social_digital ~ ". " ~ section_title_social_digital ~ ":") | yamlstr }}
{% for line in social_media_digital_lines %}
- type: paragraph
  text: {{ line | yamlstr }}
{% endfor %}
{% endif %}
{% if has_intellectual_property %}
- type: subheading
  text: {{ (letter_intellectual_property ~ ". " ~ section_title_intellectual_property ~ ":") | yamlstr }}
{% for line in intellectual_property_lines %}
- type: paragraph
  text: {{ line | yamlstr }}
{% endfor %}
{% endif %}
{% endif %}
- type: pagebreak
{% if has_residue %}
- type: paragraph
  text: {{ residue_clause | yamlstr }}
{% endif %}
{% if special_instructions %}
- type: subheading
  text: {{ (letter_special_instructions ~ ". " ~ section_title_special_instructions ~ ":") | yamlstr }}
- type: paragraph
  text: {{ special_instructions | yamlstr }}
{% endif %}
- type: paragraph
  text: {{ "I have fully understood the contents, significance and implications contained in this WILL which has been executed out of my free will, and choice. There has been no misrepresentation in regard to this WILL and no one has any right to object and/or to challenge this WILL as this is culmination of my discretion and best for me to safeguard my interest and interest of my family." | yamlstr }}
- type: paragraph
  text: {{ (title ~ " understands and approves the contents of document before signing and was not forced to do so by any person.") | yamlstr }}
- type: paragraph
  text: {{ ("Signature of " ~ title ~ ": " ~ blank) | yamlstr }}
- type: paragraph
  text: {{ ("Name of " ~ title ~ ": " ~ testator_full_name) | yamlstr }}
- type: paragraph
  text: {{ ("Place: " ~ testator_sign_place) | yamlstr }}
- type: paragraph
  text: {{ ("Date: " ~ execution_date_str) | yamlstr }}
- type: pagebreak
- type: heading
  text: {{ heading_witnesses | yamlstr }}
{% for w in witnesses %}
- type: paragraph
  text: {{ ((loop.index | string) ~ ") Name: " ~ w.name ~ "<br/>Signature: " ~ blank) | yamlstr }}
{% endfor %}
{% if show_executor %}
- type: pagebreak
- type: heading
  text: {{ heading_executor_appointment | upper | yamlstr }}
- type: paragraph
  text: {{ executor_appointment_clause | yamlstr }}
- type: paragraph
  text: {{ "The above executor shall dispose of the property and carry out the instructions as mentioned in this Will." | yamlstr }}
- type: paragraph
  text: {{ "The executor shall also be responsible for paying off any debts owed by me, taxes, and other fees due out of the proceeds of my assets." | yamlstr }}
- type: paragraph
  text: {{ "The executor may take steps to recover money due to me, with interest as agreed upon between me and the borrower." | yamlstr }}
- type: paragraph
  text: {{ "If any legal expenses are incurred in the recovery of the amount due, the executor shall be entitled to recover the said amount out of the funds belonging to me." | yamlstr }}
- type: paragraph
  text: {{ "If my executor is unable or unwilling to act with respect to property subject to administration in another jurisdiction, my beneficiaries may appoint by a signed instrument any person or qualified corporation as ancillary administrator in that jurisdiction." | yamlstr }}
- type: paragraph
  text: {{ ("Place and Date: " ~ blank) | yamlstr }}
- type: paragraph
  text: {{ ("Name of the Testator: " ~ testator_full_name) | yamlstr }}
- type: paragraph
  text: {{ ("Signature of the Testator: " ~ blank) | yamlstr }}
- type: pagebreak
- type: heading
  text: {{ heading_executor_consent | upper | yamlstr }}
- type: paragraph
  text: {{ ("I, " ~ executor_consent_name ~ ", being " ~ executor_consent_who ~ ", have read the contents of the Will and affirm my consent to act as the Executor of this Will and implement the same in the best possible manner.") | yamlstr }}
- type: paragraph
  text: {{ ("Place and Date: " ~ testator_sign_place ~ ", " ~ execution_date_str) | yamlstr }}
- type: paragraph
  text: {{ ("Name of the Executor" ~ executor_label_suffix ~ ": " ~ executor_consent_name) | yamlstr }}
- type: paragraph
  text: {{ ("Signature of the Executor" ~ executor_label_suffix ~ ": " ~ blank) | yamlstr }}
{% endif %}
{% if show_guardian %}
- type: pagebreak
- type: heading
  text: {{ heading_guardian_appointment | upper | yamlstr }}
- type: paragraph
  text: {{ guardian_appointment_clause | yamlstr }}
- type: paragraph
  text: {{ "The above-appointed guardian shall have the care, custody, and management of any property or assets inherited by my minor beneficiaries under this Will until such beneficiaries attain the age of majority. The guardian shall act in the best fiduciary interests of the minors and may apply the income or principal of the inherited assets for their education, maintenance, and welfare as deemed necessary." | yamlstr }}
- type: paragraph
  text: {{ ("Place and Date: " ~ blank) | yamlstr }}
- type: paragraph
  text: {{ ("Name of the Testator: " ~ testator_full_name) | yamlstr }}
- type: paragraph
  text: {{ ("Signature of the Testator: " ~ blank) | yamlstr }}
- type: pagebreak
- type: heading
  text: {{ heading_guardian_consent | upper | yamlstr }}
- type: paragraph
  text: {{ ("I, " ~ guardian_name ~ ", being the Guardian mentioned, have read the contents of the Will relating to the minor beneficiaries and affirm my consent to act as the Guardian and manage their inheritance in the best possible manner until they attain majority.") | yamlstr }}
- type: paragraph
  text: {{ ("Place and Date: " ~ testator_sign_place ~ ", " ~ execution_date_str) | yamlstr }}
- type: paragraph
  text: {{ ("Name of the Guardian: " ~ guardian_name) | yamlstr }}
- type: paragraph
  text: {{ ("Signature of the Guardian: " ~ blank) | yamlstr }}
{% endif %}

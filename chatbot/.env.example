# Anthropic API key. Required — no default. Get one from
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Base URL of smartwill-mcp (no path — mcp_client.py appends /mcp itself;
# see mcp/server.py). Required — no default. On Vercel this is supplied by a
# service binding instead; on AKS it's set in infra/k8s/chatbot/configmap.yaml.
MCP_SERVER_URL=http://127.0.0.1:8000

# Origins allowed to call this service's /chat endpoint. Comma-separated.
# Required — no default.
CORS_ALLOW_ORIGINS=

# Host/port this service listens on.
HOST=0.0.0.0
PORT=8010

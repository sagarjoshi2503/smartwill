# Anthropic API key. Required — no default. Get one from
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Base URL of forwardlegacy-mcp (no path — mcp_client.py appends /mcp itself;
# see mcp/server.py). Required — no default. On Vercel this is supplied by a
# service binding instead; on AKS it's set in infra/k8s/chatbot/configmap.yaml.
MCP_SERVER_URL=http://127.0.0.1:8000

# Base URL of forwardlegacy-rag (no path — rag_client.py appends /search
# itself; see rag/main.py). Required — no default. On Vercel this is
# supplied by a service binding instead; on AKS it's set in
# infra/k8s/chatbot/configmap.yaml.
RAG_SERVICE_URL=http://127.0.0.1:8030

# Base URL of forwardlegacy-flags — used to evaluate the "use-rag-or-mcp" flag
# (see feature_flags.py). Required — no default. On Vercel this is supplied
# by a service binding instead; on AKS it's set in
# infra/k8s/chatbot/configmap.yaml.
FLAGS_SERVICE_URL=http://127.0.0.1:8020

# Origins allowed to call this service's /chat endpoint. Comma-separated.
# Required — no default. Deliberately a distinct key (not CORS_ALLOW_ORIGINS,
# which api/ uses) since api/, mcp/, and chatbot/ deploy as separate Vercel
# services sharing one flat project-level env var pool.
CHATBOT_CORS_ALLOW_ORIGINS=

# Same MongoDB Atlas connection string as api/.env.example's/rag/.env.example's
# MONGODB_URI — used only to write the chatbotresponses feedback collection
# (see db.py, POST /chat/feedback). Required, no default.
MONGODB_URI=

# Host/port this service listens on.
HOST=0.0.0.0
PORT=8010

# Anthropic API key. Required — no default. Get one from
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Base URL of smartwill-mcp (no path — mcp_client.py appends /mcp itself;
# see mcp/server.py). On Vercel this is supplied by a service binding instead.
MCP_SERVER_URL=http://127.0.0.1:8000

# Origins allowed to call this service's /chat endpoint. Comma-separated.
# Defaults to the dev + prod web app origins if unset (matches
# api/_app/shared/constants.py's CORS_ALLOW_ORIGINS).
CORS_ALLOW_ORIGINS=

# Host/port this service listens on.
HOST=0.0.0.0
PORT=8010

# Base URL of the smartwill-api FastAPI backend this MCP server wraps.
# Required — no default. On Vercel this is supplied by a service binding
# instead; on AKS it's set in infra/k8s/mcp/configmap.yaml.
API_BASE_URL=http://127.0.0.1:8051

# Host/port the MCP server itself listens on (streamable-HTTP transport).
MCP_HOST=0.0.0.0
MCP_PORT=8000

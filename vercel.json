{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "web/",
      "installCommand": "npm install",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "rewrites": [
        { "source": "/admin", "destination": "/index.html" }
      ]
    },
    "api": {
      "root": "api/",
      "entrypoint": "index:app"
    },
    "flags": {
      "root": "flags/",
      "entrypoint": "flags.ts"
    },
    "mcp": {
      "root": "mcp/",
      "entrypoint": "server:app",
      "bindings": [
        { "type": "service", "service": "api", "format": "url", "env": "API_BASE_URL" }
      ]
    },
    "chatbot": {
      "root": "chatbot/",
      "entrypoint": "main:app",
      "bindings": [
        { "type": "service", "service": "mcp", "format": "url", "env": "MCP_SERVER_URL" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/flags", "destination": { "service": "flags" } },
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/docs", "destination": { "service": "api" } },
    { "source": "/openapi.json", "destination": { "service": "api" } },
    { "source": "/chat", "destination": { "service": "chatbot" } },
    { "source": "/chat/healthz", "destination": { "service": "chatbot" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
